VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-01-01

# Server-only (Vercel) — SMTP (Google Workspace / Gmail)
# Create an App Password: Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=andrea@volc4n.com
SMTP_PASS=
# Optional. Defaults to SMTP_USER
INTAKE_FROM_EMAIL=
# Optional. Default: andrea@volc4n.com
INTAKE_TO_EMAIL=andrea@volc4n.com

# Optional. Also stores submissions in Sanity Studio
SANITY_API_WRITE_TOKEN=
