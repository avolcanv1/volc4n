VITE_SANITY_PROJECT_ID=your_project_id
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-01-01

# Server-only (Vercel)
# Resend — emails briefs to andrea@volc4n.com (required for form submit)
RESEND_API_KEY=
# Optional. Default: volc4n <onboarding@resend.dev>
# After verifying volc4n.com in Resend, use e.g. volc4n <noreply@volc4n.com>
RESEND_FROM=
# Optional. Default: andrea@volc4n.com
INTAKE_TO_EMAIL=andrea@volc4n.com

# Optional. Also stores submissions in Sanity Studio
SANITY_API_WRITE_TOKEN=
